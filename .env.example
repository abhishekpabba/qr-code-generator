# Optional until you have a stable production URL. After first Vercel deployment set this to your production *.vercel.app URL.
SITE_URL=

# Strongly recommended for production dynamic QR codes and analytics.
DATABASE_URL=
PGSSL=require

# Needed only for uploaded PDF/image/audio/video QR content on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional privacy hardening for scan IP hashing.
IP_HASH_SALT=change-this-long-random-string

# Add after creating Google Analytics / Search Console if desired.
GA_MEASUREMENT_ID=

# Add only after AdSense gives you these values.
ADSENSE_CLIENT=
ADSENSE_PUBLISHER_ID=

# Optional Search Console verification token (content value only).
GSC_VERIFICATION=

# Required in production to isolate each visitor's saved QR codes. Generate a random 32+ byte value.
SESSION_SECRET=
