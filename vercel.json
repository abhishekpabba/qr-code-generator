{
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/index-v4.html" },
    { "source": "/app", "destination": "/index-v4.html" },
    { "source": "/app/", "destination": "/index-v4.html" }
  ],
  "headers": [
    { "source": "/favicon.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/site.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
